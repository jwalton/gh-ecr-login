{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "types": ["node"],
    "outDir": "./lib",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*.ts"],
}
